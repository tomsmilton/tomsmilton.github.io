---
import Base from '../../layouts/Base.astro';
import { site } from '../../site.config';

const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
// As `ls -l` prints an older file's date: "Nov  1  2026".
const lsDate = (iso: string) => {
  const [y, m, d] = iso.split('-').map(Number);
  return `${months[m - 1]} ${String(d).padStart(2, ' ')}  ${y}`;
};

// A widget on another site is a symlink: `ukc-leaderboard -> chromewebstore.google.com/…`.
const target = (href: string) => {
  const u = new URL(href);
  const path = u.pathname.replace(/\/$/, '');
  return u.host.replace(/^www\./, '') + (path.length <= 20 ? path : '/…');
};
const widgets = [...site.widgets]
  .sort((a, b) => b.made.localeCompare(a.made))
  .map((w) => {
    const external = /^https?:/.test(w.href);
    const dir = w.name.endsWith('/');
    return {
      ...w,
      external,
      dir,
      target: external ? target(w.href) : '',
      mode: external ? 'lrwxrwxrwx' : dir ? 'drwxr-xr-x' : '-rwxr-xr-x',
    };
  });
const ps1 = 'tom@tsmilton';
---
<Base title="Widgets" crumbs={[{ label: 'widgets' }]} description="Small tools Thomas Milton has made, mostly for one job each.">
  <main class="widgets">
    <div class="widgets__grid">
      <section class="intro" aria-labelledby="widgets-title">
        <p class="label">Widgets · {widgets.length} of them</p>
        <h1 id="widgets-title" class="intro__title">Small tools, each made for one job.</h1>
        <p class="intro__sub">Click one to open it, or type at the prompt. Older ones are still on the <a class="link" href="/old/widgets.html">old website</a>.</p>
      </section>

      <section class="term mono" aria-label="Widgets, as a terminal">
        <div class="term__bar" aria-hidden="true"><span>{ps1}: ~/widgets</span><span>bash</span></div>
        <div class="term__body" data-term>
          <div class="term__history" data-history>
            <p class="ln"><span class="ps1">{ps1}:<b>~</b>$</span> cd ~/widgets</p>
            <p class="ln"><span class="ps1">{ps1}:<b>~/widgets</b>$</span> ls -l</p>
            <p class="ln dim">total {widgets.length}</p>
            <ol class="ls" data-ls>
              {widgets.map((w) => (
                <li>
                  <a href={w.href} data-name={w.name.replace(/\/$/, '')} data-dir={w.dir ? '' : undefined}>
                    <span class="ls__mode" aria-hidden="true">{w.mode}</span>
                    <time class="ls__date" datetime={w.made}>{lsDate(w.made)}</time>
                    <span class:list={['ls__name', { 'ls__name--ext': w.external }]}>{w.name}{w.external && <span class="ls__target"><span class="ls__to"><span aria-hidden="true"> -&gt; </span><span class="visually-hidden">, on </span>{w.target}</span><span aria-hidden="true"> ↗︎</span></span>}</span>
                    <span class="ls__about"><span aria-hidden="true"># </span>{w.about}</span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
          <div class="term__out" data-out aria-live="polite"></div>
          <form class="ln prompt" data-prompt>
            <label class="ps1" for="term-input">{ps1}:<b>~/widgets</b>$</label>
            <span class="cursor" aria-hidden="true"></span>
            <input id="term-input" name="cmd" type="text" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" enterkeyhint="go" placeholder=" " aria-describedby="term-hint" />
          </form>
          <p id="term-hint" class="visually-hidden">Type ls to list the widgets, cd and a name to open one, or help.</p>
        </div>
      </section>
    </div>
    <p class="bigword" aria-hidden="true">widgets</p>
  </main>
</Base>

<script>
  // A very small shell: ls, cd/open <widget>, cd .. , pwd, whoami, clear, help. Tab completes widget names.
  const body = document.querySelector<HTMLElement>('[data-term]')!;
  const history = body.querySelector<HTMLElement>('[data-history]')!;
  const out = body.querySelector<HTMLElement>('[data-out]')!;
  const form = body.querySelector<HTMLFormElement>('[data-prompt]')!;
  const input = form.querySelector('input')!;
  const ls = body.querySelector<HTMLOListElement>('[data-ls]')!;
  const ps1 = form.querySelector('label')!.innerHTML;

  const widgets = [...ls.querySelectorAll<HTMLAnchorElement>('a[data-name]')].map((a) => ({ name: a.dataset.name!, href: a.href, dir: a.hasAttribute('data-dir') }));
  const find = (arg: string) => {
    const want = arg.replace(/^\.\//, '').replace(/\/$/, '').toLowerCase();
    return widgets.find((w) => w.name.toLowerCase() === want);
  };

  const line = (text: string, cls = '') => {
    const p = document.createElement('p');
    p.className = `ln ${cls}`.trim();
    p.textContent = text;
    out.append(p);
  };
  const echo = (cmd: string) => {
    const p = document.createElement('p');
    p.className = 'ln';
    p.innerHTML = `<span class="ps1">${ps1}</span> `;
    p.append(cmd);
    out.append(p);
  };
  const go = (href: string, label: string) => {
    line(`opening ${label} …`, 'dim');
    setTimeout(() => (location.href = href), 250);
  };

  const run = (raw: string) => {
    const [cmd = '', ...args] = raw.trim().split(/\s+/);
    const arg = args.filter((a) => !a.startsWith('-'))[0] ?? '';
    switch (cmd) {
      case '': return;
      case 'ls': case 'll': case 'dir': {
        const list = ls.cloneNode(true) as HTMLOListElement;
        list.removeAttribute('data-ls');
        out.append(list);
        return;
      }
      case 'cd': case 'open': case 'xdg-open': {
        if (!arg || arg === '~' || arg === '.' || arg === '~/widgets') return;
        if (arg === '..' || arg === '~/' || arg === '/') return go('/', 'home');
        const w = find(arg);
        if (w) return go(w.href, w.name);
        return line(`${cmd}: ${arg}: No such file or directory`, 'err');
      }
      case 'pwd': return line('/home/tom/widgets');
      case 'whoami': return line('tom');
      case 'clear': history.hidden = true; out.replaceChildren(); return;
      case 'exit': case 'logout': return go('/', 'home');
      case 'help': case 'man': case '?':
        line('ls              list the widgets', 'dim');
        line('cd <widget>     open one (tab completes)', 'dim');
        line('cd ..           back to the homepage', 'dim');
        line('clear           clear the screen', 'dim');
        return;
      default: {
        const w = find(cmd);
        if (w) return go(w.href, w.name);
        return line(`bash: ${cmd}: command not found (try help)`, 'err');
      }
    }
  };

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const raw = input.value;
    input.value = '';
    echo(raw);
    run(raw);
    input.scrollIntoView({ block: 'nearest' });
  });

  input.addEventListener('keydown', (e) => {
    if (e.key === 'Tab') {
      const m = input.value.match(/^(.*?\s)?(\S*)$/);
      if (!m) return;
      const [, before = '', part] = m;
      const hits = widgets.filter((w) => w.name.startsWith(part.replace(/^\.\//, '')));
      if (hits.length === 1) {
        e.preventDefault();
        input.value = `${before}${hits[0].name}${hits[0].dir ? '/' : ''}`;
      } else if (hits.length > 1 && part) {
        e.preventDefault();
        line(hits.map((w) => w.name).join('   '), 'dim');
      }
    } else if (e.key === 'l' && e.ctrlKey) {
      e.preventDefault();
      run('clear');
    }
  });

  // Clicking the terminal (but not a link in it, or a selection) puts the cursor at the prompt.
  body.addEventListener('click', (e) => {
    if ((e.target as Element).closest('a') || String(getSelection())) return;
    input.focus({ preventScroll: true });
  });
</script>

<style>
  /* Like Writing: at least one window tall, with "widgets" sitting on the bottom edge. */
  .widgets {
    --big: clamp(140px, 29vw, 420px);
    position: relative;
    max-width: var(--max);
    min-height: calc(100svh - 45px);
    margin: 0 auto;
    padding: 32px var(--gutter) calc(var(--big) * 0.7 + 32px);
    overflow: hidden;
  }
  .widgets__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 36px; align-items: start; }

  .intro { display: flex; flex-direction: column; gap: 14px; }
  .intro .label { margin: 0; }
  .intro__title { margin: 0; font-weight: 300; font-size: clamp(38px, 4.2vw, 60px); line-height: 1.04; letter-spacing: -0.01em; }
  .intro__sub { margin: 0; font-size: clamp(18px, 1.4vw, 20px); font-style: italic; line-height: 1.45; color: var(--text); max-width: 30em; }

  /* ---------- the terminal: ink on warm white, ruled like the rest of the site ---------- */
  .term { position: relative; z-index: 1; border: 1px solid var(--ink); background: var(--bg); font-size: 14px; line-height: 1.6; }
  .term__bar {
    display: flex; justify-content: space-between; gap: 12px;
    padding: 7px 14px; border-bottom: 1px solid var(--rule-strong);
    font-size: 11px; letter-spacing: 0.04em; color: var(--muted);
  }
  .term__body { padding: 14px 14px 18px; cursor: text; }
  .term__history[hidden] { display: none; }
  .term :global(.ln) { margin: 0; white-space: pre-wrap; overflow-wrap: anywhere; }
  .term :global(.dim) { color: var(--muted); }
  .term :global(.err) { color: var(--substack); }
  .term :global(.ps1) { color: var(--quick); white-space: nowrap; }
  .term :global(.ps1 b) { font-weight: 500; color: var(--ink); }

  /* the listing: each widget is a whole clickable row */
  .term :global(.ls) { list-style: none; margin: 4px 0 10px; padding: 0; }
  .term :global(.ls a) {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 2ch;
    padding: 6px 0;
    border-top: 1px dashed var(--rule);
    transition: opacity 0.3s, background 0.2s;
  }
  .term :global(.ls li:last-child a) { border-bottom: 1px dashed var(--rule); }
  .term :global(.ls__mode) { display: none; color: var(--muted); }
  .term :global(.ls__date) { white-space: pre; color: var(--muted); }
  .term :global(.ls__name) { font-weight: 500; color: var(--ink); }
  .term :global(.ls__target) { font-weight: 400; color: var(--muted); }
  .term :global(.ls__to) { display: none; }
  .term :global(.ls__about) { grid-column: 2; color: var(--quick); font-size: 13px; line-height: 1.45; }
  .term :global(.ls:hover a) { opacity: 0.35; }
  .term :global(.ls a:hover), .term :global(.ls a:focus-visible) { opacity: 1; }
  .term :global(.ls a:hover .ls__name::after), .term :global(.ls a:focus-visible .ls__name::after) { opacity: 1; }

  /* the live prompt, with a block cursor that follows the typing */
  .prompt { display: flex; align-items: baseline; gap: 1ch; margin-top: 2px; }
  .prompt input {
    flex: 1; min-width: 0; margin: 0; padding: 0; border: 0; outline: 0; background: none;
    font: inherit; color: var(--ink); caret-color: var(--ink);
  }
  /* until someone clicks in, a blinking block waits at the empty prompt */
  .prompt .cursor { display: none; }
  .prompt:not(:focus-within):has(input:placeholder-shown) .cursor {
    display: block; flex: none; align-self: center;
    width: 0.6em; height: 1.1em; background: var(--ink);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }

  .bigword {
    position: absolute;
    left: calc(var(--gutter) - 0.04em);
    bottom: -0.1em;
    margin: 0;
    font-weight: 200;
    font-size: var(--big);
    line-height: 0.78;
    letter-spacing: -0.03em;
    white-space: nowrap;
    user-select: none;
  }

  @media (min-width: 640px) {
    .term { font-size: 15px; }
    .term__body { padding: 18px 22px 22px; }
    .term__bar { padding: 8px 22px; }
    .term :global(.ls a) { grid-template-columns: auto auto minmax(0, 1fr); }
    .term :global(.ls__mode) { display: block; }
    .term :global(.ls__to) { display: inline; }
    .term :global(.ls__name:not(.ls__name--ext)::after) { content: ' →'; opacity: 0; transition: opacity 0.2s; }
    .term :global(.ls__about) { grid-column: 3; }
  }
  @media (min-width: 980px) {
    .widgets { padding-top: 64px; }
    .widgets__grid { grid-template-columns: minmax(0, 440fr) minmax(0, 720fr); column-gap: 96px; }
  }
</style>
