---
// A card for a thing a note talks about (a camera, say): its photo, its name and a
// few facts, set like the facts table beside the notes feed. Written in a note as a
// table whose first header cell is the photo and second is the name.
import { Image } from 'astro:assets';
import type { NoteImage } from '../../lib/notes';

interface Props { image: NoteImage; title: string; facts: [string, string][] }
const { image, title, facts } = Astro.props;
---
<figure class="card">
  <div class="card__photo">
    <Image src={image.src} alt={image.alt} widths={[240, 360, 480]} sizes="(min-width: 560px) 216px, 100vw" />
  </div>
  <figcaption class="card__text">
    <p class="card__name">{title}</p>
    <dl class="card__facts">
      {facts.map(([k, v]) => <div><dt>{k}</dt><dd set:html={v} /></div>)}
    </dl>
  </figcaption>
</figure>

<style>
  .card {
    display: grid; grid-template-columns: 216px minmax(0, 1fr);
    margin: 28px 0 30px; border: 1px solid var(--rule-strong); background: #fdfbf6;
  }
  /* The photo fills its side of the card; white studio backgrounds melt into the card. */
  .card__photo { position: relative; min-height: 200px; overflow: hidden; border-right: 1px solid var(--rule); }
  .card__photo :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; mix-blend-mode: multiply; }

  .card__text { padding: 18px 22px 16px; }
  .card__name { margin: 0 0 12px; font-size: 25px; font-weight: 400; line-height: 1.15; color: var(--ink); }
  .card__facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 20px; margin: 0; }
  .card__facts > div { padding: 8px 0 9px; border-top: 1px solid var(--rule); }
  .card__facts dt { margin-bottom: 3px; font-family: var(--mono); font-size: 10.5px; line-height: 1.4; letter-spacing: 0.06em; text-transform: uppercase; color: rgba(27, 47, 158, 0.62); }
  .card__facts dd { margin: 0; font-size: 17px; line-height: 1.35; font-weight: 300; color: var(--text); }

  @media (max-width: 559px) {
    .card { grid-template-columns: minmax(0, 1fr); }
    .card__photo { min-height: 0; aspect-ratio: 3 / 2; border-right: 0; border-bottom: 1px solid var(--rule); }
    .card__text { padding: 14px 16px 12px; }
    .card__facts { column-gap: 14px; }
  }
</style>
