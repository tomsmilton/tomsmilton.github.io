---
// A run of photos as a gallery: justified rows that fill the column, each row as
// tall as its photos allow, so landscape and portrait shots sit together uncropped.
// Each photo opens full size in a viewer you can step through (arrows, swipe, Esc).
// An optional caption sits under the gallery, set like a photo's caption.
import { Image, getImage } from 'astro:assets';
import Lightbox from '../Lightbox.astro';
import type { NoteImage } from '../../lib/notes';

interface Props { images: NoteImage[]; caption?: string }
const { images, caption } = Astro.props;

// About three landscape-widths per row reads well in a 640px column.
const TARGET = 2.8;
const aspect = (i: NoteImage) => i.src.width / i.src.height;
const rows: NoteImage[][] = [[]];
for (const img of images) {
  const row = rows.at(-1)!;
  if (row.reduce((s, i) => s + aspect(i), 0) >= TARGET) rows.push([img]);
  else row.push(img);
}

const full = await Promise.all(images.map((i) => getImage({ src: i.src, width: Math.min(2000, i.src.width) })));
let n = 0;
---
<figure class="gallery" data-lightbox aria-label={caption ? undefined : `${images.length} photos`}>
  {rows.map((row) => {
    const sum = row.reduce((s, i) => s + aspect(i), 0);
    return (
      <div class="gallery__row">
        {row.map((img) => {
          const i = n++;
          const share = aspect(img) / sum;
          return (
            <a class="gallery__item" href={full[i].src} data-index={i} style={`flex: ${aspect(img)} 1 0; aspect-ratio: ${img.src.width} / ${img.src.height}`}>
              <Image
                src={img.src}
                alt={img.alt}
                widths={[240, 360, 540, 720]}
                sizes={`(min-width: 700px) ${Math.round(960 * share)}px, ${Math.round(100 * share)}vw`}
              />
            </a>
          );
        })}
      </div>
    );
  })}
  {caption && <figcaption class="gallery__caption">{caption}</figcaption>}
</figure>
<Lightbox />

<style>
  .gallery { display: grid; gap: 6px; margin: 26px 0 30px; }
  .gallery__row { display: flex; gap: 6px; }
  .gallery__caption { margin-top: 4px; font-size: 15px; line-height: 1.45; font-style: italic; font-weight: 300; color: var(--quick); }
  .gallery__item { display: block; min-width: 0; background: var(--frame); overflow: hidden; cursor: zoom-in; box-shadow: none !important; }
  .gallery__item :global(img) { width: 100%; height: 100%; object-fit: cover; transition: opacity 0.2s, transform 0.4s; }
  .gallery__item:hover :global(img) { opacity: 0.88; transform: scale(1.015); }
  @media (max-width: 480px) {
    .gallery, .gallery__row { gap: 4px; }
  }
</style>
