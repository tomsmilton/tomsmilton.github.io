---
// A note's photo, sized by its shape rather than stretched to the column:
// landscape photos sit at about three-quarters of the column; portrait ones
// are capped in height with the caption beside them (under them on phones).
// A cutout (an object on a transparent background) sits smaller, centred in the column.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { src: ImageMetadata; alt: string; caption?: string; cutout?: boolean }
const { src, alt, caption, cutout = false } = Astro.props;
const portrait = !cutout && src.height > src.width * 1.1;
---
<figure class:list={['fig', cutout ? 'fig--cutout' : portrait ? 'fig--portrait' : 'fig--landscape']}>
  <Image
    src={src}
    alt={alt}
    widths={portrait || cutout ? [240, 360, 480, 720] : [480, 720, 960]}
    sizes={portrait ? '240px' : cutout ? '(min-width: 480px) 340px, 75vw' : '(min-width: 560px) 480px, 100vw'}
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .fig { margin: 26px 0 28px; }
  .fig :global(img) { display: block; height: auto; }
  figcaption { margin-top: 10px; font-size: 15px; line-height: 1.45; font-style: italic; font-weight: 300; color: var(--quick); }

  .fig--landscape :global(img) { width: min(100%, 480px); }
  .fig--landscape figcaption { max-width: 480px; }

  .fig--cutout { margin: 30px auto 32px; text-align: center; }
  .fig--cutout :global(img) { width: min(75%, 340px); margin: 0 auto; }
  .fig--cutout figcaption { max-width: 340px; margin-inline: auto; }

  .fig--portrait :global(img) { width: auto; max-width: 100%; max-height: 340px; }
  @media (min-width: 560px) {
    .fig--portrait { display: flex; align-items: flex-end; gap: 22px; }
    .fig--portrait :global(img) { max-height: 380px; flex-shrink: 0; }
    .fig--portrait figcaption { flex: 1; max-width: 220px; margin: 0 0 -4px; }
  }
</style>
