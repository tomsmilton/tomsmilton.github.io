---
// The full-screen photo viewer shared by every gallery on a page: arrows, swipe and Esc.
---
<script>
  // One viewer for every gallery on the page, built on first use. A gallery is any element
  // with data-lightbox; each link in it is a photo (its href the full-size image, its
  // data-caption the line under it).
  let dialog: HTMLDialogElement | null = null;
  let items: HTMLAnchorElement[] = [];
  let at = 0;

  function viewer() {
    if (dialog) return dialog;
    dialog = document.createElement('dialog');
    dialog.className = 'lightbox';
    dialog.innerHTML = `
      <img class="lightbox__img" alt="" />
      <button class="lightbox__btn lightbox__prev" type="button" aria-label="Previous photo">←</button>
      <button class="lightbox__btn lightbox__next" type="button" aria-label="Next photo">→</button>
      <button class="lightbox__btn lightbox__close" type="button" aria-label="Close">Close ✕</button>
      <p class="lightbox__count"></p>
      <p class="lightbox__cap"></p>`;
    document.body.append(dialog);
    dialog.querySelector('.lightbox__prev')!.addEventListener('click', () => show(at - 1));
    dialog.querySelector('.lightbox__next')!.addEventListener('click', () => show(at + 1));
    dialog.querySelector('.lightbox__close')!.addEventListener('click', () => dialog!.close());
    // A click on the backdrop (not the photo or a button) closes it.
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog!.close(); });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(at - 1);
      if (e.key === 'ArrowRight') show(at + 1);
    });
    let x0: number | null = null;
    dialog.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    dialog.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 40) show(at + (dx < 0 ? 1 : -1));
      x0 = null;
    });
    dialog.addEventListener('close', () => { document.documentElement.style.overflow = ''; items[at]?.focus(); });
    return dialog;
  }

  function show(i: number) {
    at = (i + items.length) % items.length;
    const d = viewer();
    const img = d.querySelector<HTMLImageElement>('.lightbox__img')!;
    img.src = items[at].href;
    img.alt = items[at].querySelector('img')?.alt ?? '';
    d.querySelector('.lightbox__count')!.textContent = `${at + 1} / ${items.length}`;
    d.querySelector('.lightbox__cap')!.textContent = items[at].dataset.caption ?? '';
    // Fetch the neighbours so stepping through feels instant.
    for (const j of [at - 1, at + 1]) new Image().src = items[(j + items.length) % items.length].href;
  }

  document.addEventListener('click', (e) => {
    const link = (e.target as Element).closest<HTMLAnchorElement>('[data-lightbox] a');
    if (!link || e.metaKey || e.ctrlKey || e.shiftKey) return;
    e.preventDefault();
    items = [...link.closest('[data-lightbox]')!.querySelectorAll<HTMLAnchorElement>('a')];
    show(items.indexOf(link));
    const d = viewer();
    if (!d.open) { d.showModal(); document.documentElement.style.overflow = 'hidden'; }
  });
</script>

<style is:global>
  .lightbox {
    width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0;
    background: rgba(16, 18, 34, 0.97); color: #faf7f0;
  }
  .lightbox::backdrop { background: transparent; }
  .lightbox[open] { display: grid; place-items: center; }
  .lightbox__img {
    max-width: calc(100vw - 160px); max-height: calc(100dvh - 150px);
    width: auto; height: auto; object-fit: contain; box-shadow: 0 10px 40px rgba(0, 0, 0, 0.35);
  }
  .lightbox__btn {
    position: absolute; border: 0; background: none; color: inherit; cursor: pointer;
    font-family: var(--mono); font-size: 13px; letter-spacing: 0.04em; opacity: 0.75;
  }
  .lightbox__btn:hover, .lightbox__btn:focus-visible { opacity: 1; }
  .lightbox__btn:focus-visible { outline: 1px solid currentColor; outline-offset: 4px; }
  .lightbox__prev, .lightbox__next { top: 50%; transform: translateY(-50%); padding: 24px; font-size: 22px; }
  .lightbox__prev { left: 12px; }
  .lightbox__next { right: 12px; }
  .lightbox__close { top: 18px; right: 22px; padding: 8px; }
  .lightbox__cap { position: absolute; bottom: 42px; left: 0; right: 0; margin: 0 auto; max-width: 40em; padding: 0 24px; text-align: center; font-family: var(--serif); font-style: italic; font-weight: 300; font-size: 15px; line-height: 1.4; opacity: 0.85; }
  .lightbox__cap:empty { display: none; }
  .lightbox__count { position: absolute; bottom: 20px; left: 0; right: 0; margin: 0; text-align: center; font-family: var(--mono); font-size: 12px; letter-spacing: 0.1em; opacity: 0.7; }
  @media (max-width: 600px) {
    .lightbox__img { max-width: 100vw; max-height: calc(100dvh - 140px); }
    .lightbox__prev, .lightbox__next { top: auto; bottom: 6px; transform: none; padding: 14px 20px; }
    .lightbox__prev { left: 4px; }
    .lightbox__next { right: 4px; }
  }
</style>
